<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@color/black"
    android:orientation="vertical">

    <TextView
        android:id="@+id/Signup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textAlignment="center"
        android:text="Hello Gamer"
        android:textColor="@color/purple"
        android:textSize="40dp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tagline2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:textAlignment="center"
        android:text="Create your account"
        android:textColor="@color/tagline"
        android:textSize="30dp"
        android:textStyle="italic"/>


    <androidx.cardview.widget.CardView
        android:id="@+id/signupCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="@color/black2"
        app:cardElevation="10dp"
        app:cardCornerRadius="20dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="35dp">

            <EditText
                android:id="@+id/createUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:gravity="left"
                android:hint="Create a username"
                android:textColorHint="@color/tagline"
                android:inputType="text"
                android:textColor="@color/tagline"/>

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="left"
                android:hint="Enter your email"
                android:textColorHint="@color/tagline"
                android:inputType="text"
                android:textColor="@color/tagline"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="left"
                    android:hint="Create a Password"
                    android:textColorHint="@color/tagline"
                    android:inputType="textPassword"
                    android:textColor="@color/tagline"/>

                <ImageButton
                    android:id="@+id/viewPassword1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="Show password"
                    android:color="@color/white"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/password2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="left"
                    android:hint="Confirm password"
                    android:inputType="textPassword"
                    android:textColor="@color/tagline"
                    android:textColorHint="@color/tagline" />

                <ImageButton
                    android:id="@+id/viewPassword2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"

                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="Show password"
                    android:color="@color/white"/>

            </LinearLayout>

            <Button
                android:id="@+id/SignupButton2"
                android:layout_width="250dp"
                android:layout_height="60dp"
                android:backgroundTint="@color/purple"
                android:text="Create Account"
                android:layout_gravity="center"
                android:textColor="@color/tagline"
                android:textStyle="bold"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="30dp"/>


        </LinearLayout>


    </androidx.cardview.widget.CardView>


</LinearLayout>